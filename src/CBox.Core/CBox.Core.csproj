<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CA1416：CBox.Core 实际只跑在 Windows（ACL、路径处理），跨平台警告不适用 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CBox.Core</RootNamespace>
    <AssemblyName>CBox.Core</AssemblyName>
  </PropertyGroup>

  <!-- 语言包。文件名必须用连字符（strings-zh-CN.json）：
       用点号会被 MSBuild 当成区域性，资源被塞进附属程序集，主 DLL 里就找不到了 -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" />
  </ItemGroup>

  <!-- Argon2 的实现细节保持 internal，只对测试项目开放 -->
  <ItemGroup>
    <InternalsVisibleTo Include="CBox.CryptoTest" />
  </ItemGroup>

</Project>
