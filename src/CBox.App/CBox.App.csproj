<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CipherBox</AssemblyName>
    <ApplicationIcon>Assets\CipherBox.ico</ApplicationIcon>
    <RootNamespace>CBox.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CBox.Core\CBox.Core.csproj" />
  </ItemGroup>

  <!-- 测试构建标记：由 Directory.Build.props 里的 TestBuild 决定 -->
  <PropertyGroup Condition="'$(TestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);CBTEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\CipherBox.ico" />
  </ItemGroup>

</Project>
