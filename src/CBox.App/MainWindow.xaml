<Window x:Class="CBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CBox.App"
        Title="CipherBox" Height="760" Width="920"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Icon="Assets/CipherBox.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" StateChanged="MainWindow_StateChanged" Foreground="{DynamicResource BrushText}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 圆角外框 + 阴影：AllowsTransparency 打开后由这层负责外观 -->
    <Border x:Name="ChromeBorder" CornerRadius="10" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" Background="{DynamicResource BrushWindowBackground}" Margin="8">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：深蓝底，与图标同色系 -->
        <Border x:Name="CaptionBar" Grid.Row="0" Height="40" Background="{DynamicResource BrushPrimary}" CornerRadius="10,10,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="Assets/CipherBox.ico" Width="18" Height="18"
                       Margin="12,0,10,0" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" x:Name="TitleBarText" Text="CipherBox" Foreground="White"
                           FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="MinButton_Click">
                        <Path Data="M0,5 L11,5" Stroke="White" StrokeThickness="1.3" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="MaxButton_Click">
                        <Path x:Name="MaxGlyph" Data="M0.5,0.5 L10.5,0.5 L10.5,10.5 L0.5,10.5 Z"
                              Stroke="White" StrokeThickness="1.3" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Click="CloseButton_Click">
                        <Path Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5" Stroke="White" StrokeThickness="1.3" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="1" Margin="18" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="AppTitle" Text="CipherBox" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" Text="{ui:Tr app.subtitle}"
                           Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSmall}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" x:Name="OptionsToggle" Content="{ui:Tr opt.show}"
                        VerticalAlignment="Center" Padding="12,4" Click="OptionsToggle_Click"
                        ToolTip="{ui:Tr opt.show.tip}" />
            </StackPanel>
        </Grid>

        <!-- 选项默认收起：标题旁边塞一排控件既挤又容易和标题重叠 -->
        <Border Grid.Row="1" x:Name="OptionsPanel" Visibility="Collapsed"
                Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                Padding="12,8,12,4" Margin="0,0,0,10">
            <WrapPanel>
                <!-- 专业模式开关放在选项里：放标题旁边容易被误点，也不该天天看见 -->
                <!-- 配色三态：浅色 / 深色 / 跟随系统 -->
                <TextBlock Text="{ui:Tr opt.theme.label}" VerticalAlignment="Center" Margin="0,0,8,6"
                           Foreground="{DynamicResource BrushTextMuted}" />
                <ComboBox x:Name="ThemeCombo" Width="120" Height="26" Margin="0,0,16,6"
                          VerticalAlignment="Center" VerticalContentAlignment="Center"
                          SelectionChanged="ThemeCombo_Changed"
                          ToolTip="{ui:Tr opt.theme.tip}">
                    <ComboBoxItem Content="{ui:Tr opt.theme.system}" Tag="system" />
                    <ComboBoxItem Content="{ui:Tr opt.theme.light}" Tag="light" />
                    <ComboBoxItem Content="{ui:Tr opt.theme.dark}" Tag="dark" />
                </ComboBox>
                <CheckBox x:Name="ProModeCheckBox" Content="{ui:Tr opt.pro}" IsChecked="False"
                          VerticalAlignment="Center" Margin="0,0,16,6"
                          Checked="ProMode_Changed" Unchecked="ProMode_Changed"
                          ToolTip="{ui:Tr opt.pro.tip}" />
                <CheckBox x:Name="LogCheckBox" Content="{ui:Tr opt.log}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,16,6"
                          ToolTip="{ui:Tr opt.log.tip}" />
                <CheckBox x:Name="LogPathsCheckBox" Content="{ui:Tr opt.logpaths}" IsChecked="False"
                          Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,6"
                          Checked="LogPaths_Changed" Unchecked="LogPaths_Changed"
                          ToolTip="{ui:Tr opt.logpaths.tip}" />
                <CheckBox x:Name="LogSnapshotCheckBox" Content="{ui:Tr opt.logsnapshot}" IsChecked="False"
                          Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,6"
                          Checked="LogSnapshot_Changed" Unchecked="LogSnapshot_Changed"
                          ToolTip="{ui:Tr opt.logsnapshot.tip}" />
                <CheckBox x:Name="LogAclCheckBox" Content="{ui:Tr opt.logacl}" IsChecked="False"
                          Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,6"
                          Checked="LogAcl_Changed" Unchecked="LogAcl_Changed"
                          ToolTip="{ui:Tr opt.logacl.tip}" />
                <CheckBox x:Name="KeepFailedCheckBox" Content="{ui:Tr opt.keepfailed}" IsChecked="False"
                          Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,6"
                          Checked="KeepFailed_Changed" Unchecked="KeepFailed_Changed"
                          ToolTip="{ui:Tr opt.keepfailed.tip}" />
                <CheckBox x:Name="SoundCheckBox" Content="{ui:Tr opt.sound}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,8,6"
                          Checked="SoundCheckBox_Changed" Unchecked="SoundCheckBox_Changed"
                          ToolTip="{ui:Tr opt.sound.tip}" />
                <ComboBox x:Name="SoundPresetBox" Width="110" Height="26" Margin="0,0,16,6"
                          VerticalAlignment="Center" SelectionChanged="SoundPreset_Changed"
                          ToolTip="{ui:Tr sound.preset.tip}">
                    <ComboBoxItem Content="{ui:Tr sound.quiet}" Tag="{x:Static ui:SoundPreset.Quiet}" />
                    <ComboBoxItem Content="{ui:Tr sound.standard}" Tag="{x:Static ui:SoundPreset.Standard}" IsSelected="True" />
                    <ComboBoxItem Content="{ui:Tr sound.strong}" Tag="{x:Static ui:SoundPreset.Strong}" />
                    <ComboBoxItem Content="{ui:Tr sound.silent}" Tag="{x:Static ui:SoundPreset.Silent}" />
                </ComboBox>
                <CheckBox x:Name="SlowCheckBox" Content="{ui:Tr opt.slow}" IsChecked="False"
                          VerticalAlignment="Center" Margin="0,0,16,6"
                          Checked="SlowCheckBox_Changed" Unchecked="SlowCheckBox_Changed"
                          ToolTip="{ui:Tr opt.slow.tip}" />
                <ComboBox x:Name="FaultCombo" Width="120" Height="26" Margin="0,0,16,6"
                          VerticalAlignment="Center" SelectionChanged="FaultCombo_Changed"
                          ToolTip="{ui:Tr fault.tip}">
                    <ComboBoxItem Content="{ui:Tr fault.none}" IsSelected="True" />
                    <ComboBoxItem Content="{ui:Tr fault.encrypt}" />
                    <ComboBoxItem Content="{ui:Tr fault.decrypt}" />
                </ComboBox>
                <ComboBox x:Name="LanguageCombo" Width="110" Height="26" Margin="0,0,16,6"
                          VerticalAlignment="Center" SelectionChanged="Language_Changed"
                          ToolTip="{ui:Tr opt.lang.tip}" />
                <Button Style="{StaticResource SecondaryButton}" Content="{ui:Tr opt.logdir}" Height="26" Padding="10,0" Margin="0,0,10,6"
                        Click="OpenLogFolder_Click" />
                <Button Style="{StaticResource SecondaryButton}" x:Name="EnvButton" Content="{ui:Tr opt.envissue}" Height="26" Padding="10,0"
                        Margin="0,0,0,6" Visibility="Collapsed" Click="EnvButton_Click"
                        ToolTip="{ui:Tr opt.envissue.tip}" />

            <Button Style="{StaticResource SecondaryButton}" x:Name="AssocButton"
                    Content="{ui:Tr opt.assoc.on}" Height="26" Padding="10,0" Margin="0,0,10,6"
                    Click="AssocButton_Click"
                    ToolTip="{ui:Tr opt.assoc.tip}" />
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="Tabs">

            <!-- ================= 加密 ================= -->
            <TabItem Header="{ui:Tr tab.encrypt}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource PillRadio}" x:Name="EncModeFile" Content="{ui:Tr enc.mode.file}" IsChecked="True"
                                     VerticalAlignment="Center" Margin="0,0,20,0"
                                     Checked="EncMode_Changed" />
                        <RadioButton Style="{StaticResource PillRadio}" x:Name="EncModeFolder" Content="{ui:Tr enc.mode.folder}"
                                     VerticalAlignment="Center"
                                     ToolTip="{ui:Tr enc.mode.folder.tip}"
                                     Checked="EncMode_Changed" />
                        <ComboBox x:Name="FolderModeBox" Width="200" Height="26" Margin="16,0,0,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"
                                 SelectionChanged="FolderMode_Changed"
                                 ToolTip="{ui:Tr folder.mode.tip}">
                            <ComboBoxItem Content="{ui:Tr folder.mode.archive}" Tag="Archive" IsSelected="True" />
                            <ComboBoxItem Content="{ui:Tr folder.mode.batch}" Tag="Batch" />
                        </ComboBox>
                        <ComboBox x:Name="ArchiveLevelBox" Width="215" Height="26" Margin="8,0,0,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"
                                 SelectionChanged="ArchiveLevel_Changed"
                                 ToolTip="{ui:Tr archive.level.tip}">
                            <ComboBoxItem Content="{ui:Tr archive.level.normal}" Tag="Normal" IsSelected="True" />
                            <ComboBoxItem Content="{ui:Tr archive.level.full}" Tag="Full" />
                        </ComboBox>
                    </StackPanel>

                    <Border x:Name="FolderHintBox" Visibility="Collapsed"
                            Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                            Padding="10,8" Margin="0,0,0,12">
                        <TextBlock x:Name="FolderHintText" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" />
                    </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EncInputLabel" Text="{ui:Tr enc.input}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EncInputBox" Style="{StaticResource InputTextBox}" Grid.Column="1" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Grid.Column="2" Content="{ui:Tr common.browse}" Click="EncInputBrowse_Click" />
                    </Grid>

                    <Grid x:Name="EncOutputRow" Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Tr enc.output}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EncOutputBox" Style="{StaticResource InputTextBox}" Grid.Column="1" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Grid.Column="2" Content="{ui:Tr common.saveas}" Click="EncOutputBrowse_Click" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Tr common.password}" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="EncPassword" Style="{StaticResource InputPasswordBox}" Grid.Column="1" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{ui:Tr enc.password2}" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="EncPassword2" Style="{StaticResource InputPasswordBox}" Grid.Column="1"
                                     PasswordChanged="EncPassword_Changed" />
                        <TextBlock x:Name="PwdStrengthText" Grid.Column="1" Grid.Row="1"
                                   Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSmall}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Tr enc.strength}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="EncStrengthCombo" Grid.Column="1" Height="30" Width="230"
                                  SelectionChanged="EncStrength_Changed">
                            <ComboBoxItem Content="{ui:Tr enc.strength.quick}" />
                            <ComboBoxItem Content="{ui:Tr enc.strength.standard}" IsSelected="True" />
                            <ComboBoxItem Content="{ui:Tr enc.strength.strong}" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0">
                            <TextBlock x:Name="EncStrengthHint" Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" />
                            <CheckBox x:Name="SkipTypeCheckBox" Content="{ui:Tr enc.skipcheck}"
                                      Visibility="Collapsed" Margin="0,6,0,0" IsChecked="False"
                                      ToolTip="{ui:Tr enc.skipcheck.tip}" />
                            <CheckBox x:Name="FullEncryptBox" Content="{ui:Tr enc.full}"
                                      Visibility="Collapsed" Margin="0,6,0,0" IsChecked="False"
                                      ToolTip="{ui:Tr enc.full.tip}" />
                            <StackPanel x:Name="AlgPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Text="{ui:Tr enc.alg}" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="AlgCombo" Width="190" Height="26" VerticalAlignment="Center"
                                          ToolTip="{ui:Tr enc.alg.tip}" />
                                <TextBlock Text="{ui:Tr enc.kdf}" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <ComboBox x:Name="KdfCombo" Width="170" Height="26" VerticalAlignment="Center"
                                          SelectionChanged="Kdf_Changed"
                                          ToolTip="{ui:Tr enc.kdf.tip}" />
                            </StackPanel>
                            <StackPanel x:Name="DisplayNamePanel" Orientation="Horizontal"
                                        Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Text="{ui:Tr enc.displayname}" Foreground="{DynamicResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
<TextBox x:Name="DisplayNameBox" Style="{StaticResource InputTextBox}" Width="200" Height="24"
                                         VerticalContentAlignment="Center"
                                         TextChanged="DisplayName_Changed"
                                         ToolTip="{ui:Tr enc.displayname.tip}" />
                                <TextBlock Text="{ui:Tr enc.displayname.hint}" Foreground="{DynamicResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>

                            <!-- 密钥文件（专业模式）：口令之外的第二把钥匙 -->
                            <StackPanel x:Name="EncKeyFilePanel" Orientation="Horizontal"
                                        Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Text="{ui:Tr keyfile.label}" Foreground="{DynamicResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="EncKeyFileBox" Style="{StaticResource InputTextBox}" Width="240" Height="26"
                                         IsReadOnly="True" ToolTip="{ui:Tr keyfile.tip}" />
                                <Button Content="{ui:Tr common.browse}" Margin="8,0,0,0" Height="26"
                                        Click="EncKeyFile_Click" />
                                <Button Content="{ui:Tr keyfile.clear}" Margin="8,0,0,0" Height="26"
                                        Click="EncKeyFileClear_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,4,0,14">
                        <ProgressBar x:Name="EncProgress" Height="24"
                                     Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="EncProgressText" Text=""
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
                    </Grid>

                    <StackPanel x:Name="EncButtonRow" Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource PrimaryButton}" x:Name="EncStartButton" Content="{ui:Tr enc.start}" Width="120"
                                Click="EncStart_Click" IsDefault="True" />
                        <CheckBox x:Name="TestFailEncCheckBox" Content="{ui:Tr fault.arm}"
                                  VerticalAlignment="Center" Margin="14,0,0,0" IsChecked="False"
                                  Visibility="Collapsed"
                                  Checked="TestFailEnc_Changed" Unchecked="TestFailEnc_Changed"
                                  ToolTip="{ui:Tr fault.arm.tip}" />
                        <TextBlock x:Name="EncHint" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}" Text="{ui:Tr enc.drop.hint}" />
                    </StackPanel>
                </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 解密 ================= -->
            <TabItem Header="{ui:Tr tab.decrypt}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource PillRadio}" x:Name="DecModeFile" Content="{ui:Tr dec.mode.file}" IsChecked="True"
                                     VerticalAlignment="Center" Margin="0,0,20,0"
                                     Checked="DecMode_Changed" />
                        <RadioButton Style="{StaticResource PillRadio}" x:Name="DecModeFolder" Content="{ui:Tr dec.mode.folder}"
                                     VerticalAlignment="Center"
                                     ToolTip="{ui:Tr dec.mode.folder.tip}"
                                     Checked="DecMode_Changed" />
                    </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DecInputLabel" Text="{ui:Tr dec.input}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DecInputBox" Style="{StaticResource InputTextBox}" Grid.Column="1" Margin="0,0,8,0"
                                 TextChanged="DecInput_TextChanged" />
                        <Button Style="{StaticResource SecondaryButton}" Grid.Column="2" Content="{ui:Tr common.browse}" Click="DecInputBrowse_Click" />
                    </Grid>

                    <Grid x:Name="DecOutputRow" Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Tr dec.output}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DecOutputBox" Style="{StaticResource InputTextBox}" Grid.Column="1" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Grid.Column="2" Content="{ui:Tr common.choose}" Click="DecOutputBrowse_Click" />
                    </Grid>

                    <Grid x:Name="DecNameRow" Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Tr dec.savename}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DecNameBox" Style="{StaticResource InputTextBox}" Grid.Column="1" Margin="0,0,8,0"
                                 TextChanged="DecName_Changed" ToolTip="{ui:Tr dec.savename.tip}" />
                        <TextBlock x:Name="DecNameHint" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}" Text="{ui:Tr dec.savename.hint}" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Tr common.password}" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="DecPassword" Style="{StaticResource InputPasswordBox}" Grid.Column="1" />
                    </Grid>


                    <!-- 密钥文件（可选）：文件需要第二把钥匙时填这里 -->
                    <Grid x:Name="DecKeyFileRow" Grid.Row="4" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Tr keyfile.label}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DecKeyFileBox" Grid.Column="1" Style="{StaticResource InputTextBox}"
                                 IsReadOnly="True" ToolTip="{ui:Tr keyfile.tip}" />
                        <Button Grid.Column="2" Content="{ui:Tr common.browse}" Margin="8,0,0,0" Height="36"
                                Click="DecKeyFile_Click" />
                    </Grid>
                    <Grid Grid.Row="5" Margin="0,8,0,14">
                        <ProgressBar x:Name="DecProgress" Height="24"
                                     Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="DecProgressText" Text=""
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
                    </Grid>

                    <StackPanel x:Name="DecButtonRow" Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource PrimaryButton}" x:Name="DecStartButton" Content="{ui:Tr dec.start}" Width="120"
                                Click="DecStart_Click" />
                        <CheckBox x:Name="TestFailDecCheckBox" Content="{ui:Tr fault.arm}"
                                  VerticalAlignment="Center" Margin="14,0,0,0" IsChecked="False"
                                  Visibility="Collapsed"
                                  Checked="TestFailDec_Changed" Unchecked="TestFailDec_Changed"
                                  ToolTip="{ui:Tr fault.arm.tip}" />
                        <Button Style="{StaticResource SecondaryButton}" x:Name="PreviewButton" Content="{ui:Tr preview.button}" Width="110" Margin="8,0,0,0"
                                Click="PreviewArchive_Click" Visibility="Collapsed"
                                ToolTip="{ui:Tr preview.button.tip}" />
                        <Button Style="{StaticResource SecondaryButton}" x:Name="DecViewButton" Content="{ui:Tr dec.view}" Width="100" Margin="8,0,0,0"
                                Click="DecView_Click" Visibility="Collapsed"
                                ToolTip="{ui:Tr dec.view.tip}" />
                        <TextBlock x:Name="DecHint" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}" Text="{ui:Tr dec.output.hint}" />
                    </StackPanel>
                </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="12,6" Background="{DynamicResource BrushSurfaceAlt}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="StatusText" Text="{ui:Tr status.ready}" TextWrapping="Wrap" Foreground="{DynamicResource BrushText}" FontSize="{StaticResource FontBody}" />
        </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
