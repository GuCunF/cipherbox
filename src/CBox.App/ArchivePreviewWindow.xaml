<Window x:Class="CBox.App.ArchivePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CBox.App"
        Title="{ui:Tr preview.title}" Height="620" Width="760"
        WindowStartupLocation="CenterOwner" Icon="Assets/CipherBox.ico" Background="{StaticResource BrushSurface}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" x:Name="NoteText" Foreground="{StaticResource BrushTextMuted}"
                   Margin="0,6,0,10" TextWrapping="Wrap" Text="{ui:Tr preview.note}" />

        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4">
            <TreeView x:Name="EntryTree" BorderThickness="0" Padding="6"
                      VirtualizingStackPanel.IsVirtualizing="False" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{ui:Tr preview.selectall}" Width="100" Height="30" Margin="0,0,8,0"
                    Click="SelectAll_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="{ui:Tr preview.selectnone}" Width="110" Height="30" Margin="0,0,20,0"
                    Click="SelectNone_Click" />
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
            <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr preview.extract}" Width="130" Height="30" Margin="20,0,8,0"
                    Click="Extract_Click" IsDefault="True" />
            <Button Style="{StaticResource SecondaryButton}" Content="{ui:Tr common.close}" Width="90" Height="30" Click="Close_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>