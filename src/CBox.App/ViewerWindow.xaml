<Window x:Class="CBox.App.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CBox.App"
        Title="{ui:Tr app.title}" Height="660" Width="920"
        MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed" Icon="Assets/CipherBox.ico">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MetaText" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <TextBox x:Name="ContentBox"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, 微软雅黑"
                     TextWrapping="NoWrap"
                     BorderBrush="#DDDDDD" />

            <Border x:Name="ImageHost" Visibility="Collapsed" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                    PreviewMouseWheel="ImageHost_PreviewMouseWheel">
                <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="ContentImage" Stretch="None" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="EncodingText" Foreground="#666666" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Foreground="#666666" Margin="12,0,0,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="LoadProgress" Width="140" Height="6" Margin="12,0,0,0"
                             Minimum="0" Maximum="100" Visibility="Collapsed" VerticalAlignment="Center" />

                <StackPanel x:Name="ZoomPanel" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{ui:Tr view.zoom}" Foreground="#666666" VerticalAlignment="Center" />
                    <Slider x:Name="ZoomSlider" Width="150" Margin="8,0" Minimum="0" Maximum="100"
                            VerticalAlignment="Center" IsSnapToTickEnabled="False"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="ZoomText" Text="100%" Width="48" Foreground="#666666" VerticalAlignment="Center" />
                    <Button x:Name="FitButton" Content="{ui:Tr view.fit}" Height="26" Padding="10,0"
                            Margin="4,0,0,0" Click="Fit_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="{ui:Tr view.cancel}" Width="70" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="Cancel_Click"
                        ToolTip="{ui:Tr view.cancel.tip}" />
                <Button x:Name="EditButton" Content="{ui:Tr view.edit}" Width="80" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="Edit_Click"
                        ToolTip="{ui:Tr view.edit.tip}" />
                <Button x:Name="SaveButton" Content="{ui:Tr view.save}" Width="80" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="Save_Click"
                        ToolTip="{ui:Tr view.save.tip}" />
                <Button x:Name="CancelEditButton" Content="{ui:Tr view.canceledit}" Width="90" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="CancelEdit_Click" />
                <Button x:Name="MoreButton" Content="{ui:Tr view.next}" Width="100" Margin="0,0,8,0"
                        Click="More_Click" IsEnabled="False" />
                <Button x:Name="ExportButton" Content="{ui:Tr view.export}" Width="100" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="Export_Click"
                        ToolTip="{ui:Tr view.export.tip}" />
                <Button Content="{ui:Tr common.close}" Width="80" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
