<Window x:Class="CBox.App.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CBox.App"
        Title="{ui:Tr password.title}" Height="230" Width="460"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="Assets/CipherBox.ico">

    <StackPanel Margin="20">
        <TextBlock Text="{ui:Tr password.heading}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,6,0,14"
                   Text="{ui:Tr password.hint}" />
        <PasswordBox x:Name="PasswordInput" Height="32" VerticalContentAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{ui:Tr common.ok}" Width="96" Height="32" Margin="0,0,10,0"
                    Click="Ok_Click" IsDefault="True" />
            <Button Content="{ui:Tr common.cancel}" Width="96" Height="32" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
