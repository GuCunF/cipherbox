<Window x:Class="CBox.App.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CBox.App"
        Title="{ui:Tr password.title}" Height="230" Width="460"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="Assets/CipherBox.ico" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 圆角外框 + 阴影：AllowsTransparency 打开后由这层负责外观 -->
    <Border x:Name="ChromeBorder" CornerRadius="10" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" Background="{DynamicResource BrushSurface}" Margin="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：拖动由 WindowChrome 的 CaptionHeight 负责，这里只画外观 -->
        <Border x:Name="CaptionBar" Grid.Row="0" Background="{DynamicResource BrushPrimary}" CornerRadius="10,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="12" Foreground="White" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <Button Grid.Column="1" Content="&#x2715;" Width="42" Height="32"
                        Style="{StaticResource CaptionCloseButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="ChromeClose_Click" />
            </Grid>
        </Border>     <StackPanel Grid.Row="1" Margin="20">
        <TextBlock Text="{ui:Tr password.heading}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" Margin="0,6,0,14"
                   Text="{ui:Tr password.hint}" />
        <PasswordBox x:Name="PasswordInput" Style="{StaticResource ThemedPasswordBox}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr common.ok}" Width="96" Height="32" Margin="0,0,10,0"
                    Click="Ok_Click" IsDefault="True" />
            <Button Style="{StaticResource SecondaryButton}" Content="{ui:Tr common.cancel}" Width="96" Height="32" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
    </Grid>
    </Border>
</Window>