<Window x:Class="CBox.App.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CBox.App"
        Title="{ui:Tr conflict.title}" Height="360" Width="620"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="Assets/CipherBox.ico">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{ui:Tr conflict.heading}"
                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="{ui:Tr conflict.path}" Foreground="#666666" />
            <TextBlock x:Name="PathText" TextWrapping="Wrap" FontFamily="Consolas"
                       Background="#F5F5F5" Padding="8" Margin="0,4,0,0" />

            <TextBlock Text="{ui:Tr conflict.explain}" Margin="0,14,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{ui:Tr conflict.warning}" Foreground="#B22222"
                       Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <CheckBox Grid.Row="2" x:Name="ApplyAllCheck" Content="{ui:Tr conflict.applyall}"
                  Margin="0,16,0,0" IsChecked="False" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{ui:Tr conflict.overwrite}" Width="130" Height="34" Margin="0,0,8,0"
                    Click="Overwrite_Click" />
            <Button Content="{ui:Tr conflict.skip}" Width="130" Height="34" Margin="0,0,8,0"
                    Click="Skip_Click" IsDefault="True" />
            <Button Content="{ui:Tr conflict.cancel}" Width="130" Height="34"
                    Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
