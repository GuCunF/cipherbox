<Window x:Class="CBox.App.OverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CBox.App"
        Title="{ui:Tr overwrite.title}" Height="300" Width="600"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="Assets/CipherBox.ico" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 圆角外框 + 阴影：AllowsTransparency 打开后由这层负责外观 -->
    <Border x:Name="ChromeBorder" CornerRadius="10" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1" Background="{StaticResource BrushSurface}" Margin="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：拖动由 WindowChrome 的 CaptionHeight 负责，这里只画外观 -->
        <Border x:Name="CaptionBar" Grid.Row="0" Background="{StaticResource BrushWarning}" CornerRadius="10,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="12" Foreground="White" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <Button Grid.Column="1" Content="&#x2715;" Width="42" Height="32"
                        Style="{StaticResource CaptionCloseButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="ChromeClose_Click" />
            </Grid>
        </Border>     <Grid Grid.Row="1" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{ui:Tr overwrite.heading}"
                   FontSize="16" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock x:Name="PathText" TextWrapping="Wrap" FontFamily="Consolas"
                       Background="{StaticResource BrushSurfaceAlt}" Padding="8" />
            <TextBlock x:Name="InfoText" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0" />
            <TextBlock Text="{ui:Tr overwrite.warning}"
                       Foreground="{StaticResource BrushDanger}" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr overwrite.replace}" Width="90" Height="32" Margin="0,0,8,0" Click="Replace_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="{ui:Tr overwrite.saveas}" Width="130" Height="32" Margin="0,0,8,0"
                    Click="SaveAsNew_Click" IsDefault="True" />
            <Button Style="{StaticResource SecondaryButton}" Content="{ui:Tr common.cancel}" Width="90" Height="32" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
    </Grid>
    </Border>
</Window>