<Window x:Class="CBox.App.OverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CBox.App"
        Title="{ui:Tr overwrite.title}" Height="300" Width="600"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="Assets/CipherBox.ico">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{ui:Tr overwrite.heading}"
                   FontSize="16" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock x:Name="PathText" TextWrapping="Wrap" FontFamily="Consolas"
                       Background="#F5F5F5" Padding="8" />
            <TextBlock x:Name="InfoText" Foreground="#666666" Margin="0,8,0,0" />
            <TextBlock Text="{ui:Tr overwrite.warning}"
                       Foreground="#B22222" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{ui:Tr overwrite.replace}" Width="90" Height="32" Margin="0,0,8,0" Click="Replace_Click" />
            <Button Content="{ui:Tr overwrite.saveas}" Width="130" Height="32" Margin="0,0,8,0"
                    Click="SaveAsNew_Click" IsDefault="True" />
            <Button Content="{ui:Tr common.cancel}" Width="90" Height="32" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
