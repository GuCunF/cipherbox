<!--
    深色主题：只覆盖颜色令牌，别的什么都不放。

    用法：App 启动时如果设置是深色，就把本字典追加在 Theme.xaml 后面合并。
    同一 key 后合并的优先，所以这里只需要重新定义颜色。

    为什么不在运行时动态切换：
      界面里全是 {StaticResource}，换字典不会让已经渲染的控件变脸。
      要求「重启生效」比把几百处 StaticResource 改成 DynamicResource 更稳。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主色在深色背景下要提亮，否则对比度不够 -->
    <SolidColorBrush x:Key="BrushPrimary" Color="#4C8FD6" />
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="#3A72B0" />
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="#22303F" />

    <SolidColorBrush x:Key="BrushBorder" Color="#39424F" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#57637A" />
    <SolidColorBrush x:Key="BrushBorderFocus" Color="#4C8FD6" />

    <SolidColorBrush x:Key="BrushText" Color="#E6EAF0" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#98A4B6" />

    <SolidColorBrush x:Key="BrushSurface" Color="#1E242F" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#252C38" />
    <SolidColorBrush x:Key="BrushWindowBackground" Color="#141820" />

    <!-- 状态色：深色背景上要更亮一档 -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#43C07F" />
    <SolidColorBrush x:Key="BrushDanger" Color="#E3695A" />
    <SolidColorBrush x:Key="BrushWarning" Color="#DFA63D" />

    <!-- 标题栏保持品牌蓝，但在深色下压暗一点，免得刺眼 -->
    <SolidColorBrush x:Key="BrushCaptionBar" Color="#1B4B84" />

</ResourceDictionary>
