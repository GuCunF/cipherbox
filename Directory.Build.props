<Project>

  <!--
    版本号规则（三处唯一来源，改这里就行）
      主版本 . 阶段版本 . 补丁
      - 主版本：整体世代，重构或格式大改才动
      - 阶段版本：对应开发阶段 A=1.1、B=1.2、C=1.3 …
      - 补丁：每次改动 +1，用来区分"是不是最新的构建"

    当前：1.2.0 = 进入 B 阶段（只读查看器），先做编码与平台抽象
    1.2.x 收尾：文本查看器 → 图片 → 拒绝引导 → 环境监测 → 强度档位 → 参数集中
    （完整 1.x 规划见项目内部文档，不随仓库发布）
  -->
  <PropertyGroup>
    <Version>2.0.1.11</Version>
    <FileVersion>2.0.1.11</FileVersion>
    <AssemblyVersion>2.0.1.11</AssemblyVersion>
    <Product>CipherBox</Product>
    <Company>CipherBox</Company>

    <!--
      测试构建开关：
        true  = 开发/测试期。点击加密/解密后**保留**口令框内容，方便用同一口令反复测试
        false = 正式发布。点击后**立刻清空**口令框

      发布前把它改成 false，并重新构建。
    -->
    <TestBuild>true</TestBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(TestBuild)' == 'true'">
    <AssemblyMetadata Include="TestBuild" Value="true" />
  </ItemGroup>

  <!-- 测试构建标记：全局生效，Core / CLI / GUI 都能拿到 CBTEST -->
  <PropertyGroup Condition="'$(TestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);CBTEST</DefineConstants>
  </PropertyGroup>
</Project>
